# frpc client config for one wd-remote-access@<gateway> instance.
# Placeholders (@VAR@) are filled in by scripts/20-install-wd-rac.sh, which
# renders this header once per gateway and appends one [[proxies]] block per
# exposed service (vm-ssh always; vm-web / host-ssh / host-ui when asked).
serverAddr = "@WD_FRPS_SERVER@"
serverPort = @WD_FRPS_PORT@

# Node identity: hash of this node's registered pubkey, checked by the
# gateway's ssh-key auth plugin on login. Identical on every gateway.
user = "@WD_RAC_USER@"
auth.token = "@WD_FRPS_TOKEN@"

# The gateway's secure frps forces TLS
transport.tls.enable = true

# Reconnect forever if the server is unreachable at startup
loginFailExit = false
