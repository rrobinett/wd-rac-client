[Unit]
Description=WsprDaemon Remote Access Client (frpc reverse tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/frpc -c /etc/wd-remote-access/frpc.toml
Restart=always
RestartSec=10
# frpc needs no privileges beyond reading its config
User=wd-rac
Group=wd-rac
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
